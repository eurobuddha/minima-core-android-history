<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy (API < 31) Auto Backup rules. This file cannot express the cloud-vs-transfer split that
   data_extraction_rules.xml uses on Android 12+, and the user's full transaction history
   (`minima_history.db`) must not reach a cloud, so on old devices we back up NOTHING.

   Consequence, accepted deliberately: on API < 31 the archive is not carried by Auto Backup. It cannot be
   rebuilt by resyncing (the node drops old history), so on those devices it is lost with the install.
   Android 12+ device transfer still carries it — see data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
